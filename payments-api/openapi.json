{
  "openapi": "3.0.1",
  "info": {
    "title": "payments",
    "version": "1"
  },
  "paths": {
    "/api/payments/{id}": {
      "get": {
        "operationId": "getPayment",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Payment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "fee": {
            "type": "number"
          }
        }
      }
    }
  }
}
